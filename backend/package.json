{
  "name": "husqvarna-flags-backend",
  "version": "1.0.0",
  "description": "Backend API for Feature Flag Management & Audit Trail with Layered Architecture & POJOs",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "prestart": "sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "start": "node dist/src/server.js",
    "dev": "npm run db:migrate && npm run db:seed && ts-node-dev --respawn --transpile-only src/server.ts",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint 'src/**/*.{ts,js}'"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
